# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env no repositorio.

# Chave de API do Google Gemini
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo do Gemini a usar (padrao: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------
# Telegram Bot (Fases 5 a 10)
# ------------------------------------------------------------------
# Crie um bot falando com o @BotFather no Telegram para obter o token
TELEGRAM_TOKEN=seu_token_do_telegram_aqui

# ------------------------------------------------------------------
# Google Drive Webhook Principal (Apps Script)
# ------------------------------------------------------------------
APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_SCRIPT_ID/exec

# ------------------------------------------------------------------
# Multi-Usuario / Multi-Cofre (Opcional - ate 20 usuarios)
# ------------------------------------------------------------------
# Envie /meuid para o bot no Telegram para descobrir o ID numerico de cada pessoa.
# Se USER_1_ID for preenchido, o bot passa a aceitar apenas usuarios cadastrados abaixo:
# USER_1_ID=111111111
# USER_1_NAME=Ariston
# USER_1_APPS_SCRIPT_URL=https://script.google.com/macros/s/SCRIPT_USUARIO_1/exec

# USER_2_ID=222222222
# USER_2_NAME=OutroUsuario
# USER_2_APPS_SCRIPT_URL=https://script.google.com/macros/s/SCRIPT_USUARIO_2/exec
